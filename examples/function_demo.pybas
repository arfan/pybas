10 PRINT "=== DEF/ENDDEF Function Demo ==="
20 PRINT "Testing function calls"
30 PRINT "Calling ADD function:"
40 RESULT = ADD(5, 3)
50 PRINT "5 + 3 ="
60 PRINT RESULT
70 PRINT "Calling MULTIPLY function:"
80 RESULT = MULTIPLY(4, 7)
90 PRINT "4 * 7 ="
100 PRINT RESULT
110 PRINT "Calling GREET function:"
120 GREET("World")
130 PRINT "Demo complete"
140 END
150 DEF ADD(X, Y)
160   LET RESULT = X + Y
170   RETURN RESULT
180 ENDDEF
190 DEF MULTIPLY(A, B)
200   LET PRODUCT = A * B
210   RETURN PRODUCT
220 ENDDEF
230 DEF GREET(NAME)
240   PRINT "Hello, " + NAME + "!"
250   RETURN
260 ENDDEF
