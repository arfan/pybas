10 REM Math utility fun200 DEF FACTORIAL(N)
210   IF N <= 1 GOTO 300
220   LET RESULT = 1
230   LET I = 2
240   IF I > N GOTO 290
250   LET RESULT = RESULT * I
260   LET I = I + 1
270   IF I <= N GOTO 250
280   RETURN RESULT
290   RETURN RESULT
300   LET RESULT = 1
310   RETURN RESULT
320 ENDDEF This file contains reusable math functions

30 DEF SQUARE(X)
40   LET RESULT = X * X
50   RETURN RESULT
60 ENDDEF

70 DEF CUBE(X)
80   LET RESULT = X * X * X
90   RETURN RESULT
100 ENDDEF

110 DEF POWER(BASE, EXPONENT)
120   LET RESULT = 1
130   LET I = 1
140   IF I > EXPONENT GOTO 170
150   LET RESULT = RESULT * BASE
160   LET I = I + 1
170   IF I <= EXPONENT GOTO 150
180   RETURN RESULT
190 ENDDEF

200 DEF FACTORIAL(N)
210   IF N <= 1 GOTO 250
220   LET RESULT = 1
230   LET I = 2
240   IF I > N GOTO 270
250   LET RESULT = RESULT * I
260   LET I = I + 1
270   IF I <= N GOTO 250
280   RETURN RESULT
290 GOTO 310
300 LET RESULT = 1
310 RETURN RESULT
320 ENDDEF

330 DEF MAX(A, B)
340   IF A > B GOTO 360
350   RETURN B
360   RETURN A
370 ENDDEF

380 DEF MIN(A, B)
390   IF A < B GOTO 410
400   RETURN B
410   RETURN A
420 ENDDEF