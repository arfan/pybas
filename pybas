#!/usr/bin/env python3

import sys

class BasicInterpreter:
    def __init__(self, program_lines):
        self.program = {}
        self.vars = {}
        self.pc = None
        self.stack = []
        self.for_stack = []  # Stack for FOR loops
        self.gosub_stack = []  # Stack for GOSUB/RETURN subroutines
        self.functions = {}  # Store DEF...ENDDEF function definitions
        self.function_call_stack = []  # Stack for function calls with local variables

        # Load program into a dict {line_number: statement}
        for line in program_lines:
            line = line.strip()
            if not line or line.startswith("'"):  # allow comments
                continue
            num, stmt = line.split(" ", 1)
            self.program[int(num)] = stmt.strip()

        # Parse and store function definitions
        self.parse_functions()
        
        self.pc = min(self.program.keys())

    def parse_functions(self):
        """Parse DEF...ENDDEF function definitions and store them"""
        sorted_lines = sorted(self.program.keys())
        i = 0
        
        while i < len(sorted_lines):
            line_num = sorted_lines[i]
            stmt = self.program[line_num].upper()
            
            if stmt.startswith("DEF "):
                # Found function definition
                func_line = self.program[line_num]
                func_name, params = self.parse_def_statement(func_line)
                
                # Find the matching ENDDEF
                func_body = {}
                i += 1
                
                while i < len(sorted_lines):
                    body_line_num = sorted_lines[i]
                    body_stmt = self.program[body_line_num]
                    
                    if body_stmt.upper().strip() == "ENDDEF":
                        # Found end of function
                        break
                    else:
                        # Add line to function body
                        func_body[body_line_num] = body_stmt
                    i += 1
                
                if i >= len(sorted_lines):
                    print(f"Error: DEF {func_name} missing ENDDEF")
                    sys.exit(1)
                
                # Store function definition
                self.functions[func_name.upper()] = {
                    'params': params,
                    'body': func_body,
                    'def_line': line_num
                }
                
                # Remove function lines from main program
                del self.program[line_num]  # DEF line
                for body_line in func_body:
                    del self.program[body_line]
                del self.program[sorted_lines[i]]  # ENDDEF line
            
            i += 1

    def parse_def_statement(self, stmt):
        """Parse DEF statement and extract function name and parameters"""
        # Example: DEF CALCULATE(X, Y)
        parts = stmt[4:].strip()  # Remove "DEF "
        
        if '(' in parts and ')' in parts:
            func_name = parts[:parts.index('(')].strip()
            param_part = parts[parts.index('(') + 1:parts.rindex(')')].strip()
            
            if param_part:
                params = [p.strip() for p in param_part.split(',')]
            else:
                params = []
        else:
            # Function without parameters
            func_name = parts.strip()
            params = []
        
        return func_name, params

    def try_execute_function_call(self, stmt):
        """Try to execute a statement as a function call"""
        try:
            # Parse potential function call
            if '(' not in stmt or ')' not in stmt:
                return False
            
            func_name_part = stmt[:stmt.index('(')].strip()
            
            # Check if it's a variable assignment with function call
            if '=' in func_name_part:
                # Example: RESULT = CALCULATE(5, 3)
                var_name, func_call = func_name_part.split('=', 1)
                var_name = var_name.strip()
                func_name = func_call.strip()
            else:
                # Direct function call: CALCULATE(5, 3)
                var_name = None
                func_name = func_name_part
            
            # Extract parameters
            param_part = stmt[stmt.index('(') + 1:stmt.rindex(')')].strip()
            if param_part:
                # Evaluate each parameter
                param_values = []
                for param in param_part.split(','):
                    param_values.append(self.safe_eval(param.strip(), self.pc))
            else:
                param_values = []
            
            # Check if function exists
            if func_name.upper() not in self.functions:
                return False
            
            # Call the function
            result = self.call_function(func_name.upper(), param_values)
            
            # Store result if variable assignment
            if var_name:
                self.vars[var_name] = result
            
            return True
            
        except Exception:
            return False

    def call_function(self, func_name, param_values):
        """Execute a user-defined function"""
        func_def = self.functions[func_name]
        
        # Check parameter count
        if len(param_values) != len(func_def['params']):
            print(f"Error on line {self.pc}: Function {func_name} expects {len(func_def['params'])} parameters, got {len(param_values)}")
            sys.exit(1)
        
        # Save current variable state
        saved_vars = self.vars.copy()
        
        # Set function parameters as local variables
        for i, param_name in enumerate(func_def['params']):
            self.vars[param_name] = param_values[i]
        
        # Save current execution state
        saved_pc = self.pc
        saved_program = self.program
        
        # Execute function body
        self.program = func_def['body']
        if self.program:
            self.pc = min(self.program.keys())
            
            return_value = None
            
            while self.pc in self.program:
                stmt = self.program[self.pc]
                stmt_upper = stmt.upper()
                
                # Handle RETURN with value
                if stmt_upper.startswith("RETURN"):
                    parts = stmt.split(None, 1)
                    if len(parts) > 1:
                        # RETURN expression
                        return_value = self.safe_eval(parts[1], self.pc)
                    else:
                        # Just RETURN
                        return_value = None
                    break
                
                # Execute statement
                next_pc = self.execute(stmt)
                
                if next_pc is not None:
                    self.pc = next_pc
                else:
                    # Move to next line
                    next_lines = sorted([n for n in self.program if n > self.pc])
                    self.pc = next_lines[0] if next_lines else None
        else:
            return_value = None
        
        # Restore execution state
        self.pc = saved_pc
        self.program = saved_program
        
        # Restore variables (keeping only new global variables)
        new_vars = {}
        for var, value in self.vars.items():
            if var not in func_def['params'] and var not in saved_vars:
                new_vars[var] = value
        
        self.vars = saved_vars
        self.vars.update(new_vars)
        
        return return_value if return_value is not None else 0

    def safe_eval(self, expression, line_num=None):
        """Safely evaluate a Python expression with user-friendly error messages."""
        try:
            # Pre-process function calls in expressions
            processed_expr = self.preprocess_function_calls(expression)
            return eval(processed_expr, {}, self.vars)
        except ZeroDivisionError:
            error_msg = f"Error on line {line_num}: Division by zero"
            print(error_msg)
            sys.exit(1)
        except NameError as e:
            var_name = str(e).split("'")[1] if "'" in str(e) else "unknown"
            error_msg = f"Error on line {line_num}: Variable '{var_name}' is not defined"
            print(error_msg)
            sys.exit(1)
        except SyntaxError:
            error_msg = f"Error on line {line_num}: Invalid expression syntax"
            print(error_msg)
            sys.exit(1)
        except ValueError as e:
            error_msg = f"Error on line {line_num}: Invalid value - {str(e)}"
            print(error_msg)
            sys.exit(1)
        except TypeError as e:
            error_msg = f"Error on line {line_num}: Type error - {str(e)}"
            print(error_msg)
            sys.exit(1)
        except Exception as e:
            error_msg = f"Error on line {line_num}: {str(e)}"
            print(error_msg)
            sys.exit(1)

    def preprocess_function_calls(self, expression):
        """Replace function calls in expressions with their return values"""
        import re
        
        # Find function calls: WORD(params)
        pattern = r'([A-Z_][A-Z0-9_]*)\s*\(([^)]*)\)'
        
        def replace_func_call(match):
            func_name = match.group(1).upper()
            params_str = match.group(2).strip()
            
            # Check if this is a user-defined function
            if func_name in self.functions:
                # Evaluate parameters
                if params_str:
                    param_values = []
                    for param in params_str.split(','):
                        param_values.append(self.safe_eval(param.strip(), self.pc))
                else:
                    param_values = []
                
                # Call function and return the result
                result = self.call_function(func_name, param_values)
                return str(result)
            else:
                # Not a user function, return as-is
                return match.group(0)
        
        # Keep replacing until no more function calls found
        prev_expr = ""
        while prev_expr != expression:
            prev_expr = expression
            expression = re.sub(pattern, replace_func_call, expression, flags=re.IGNORECASE)
        
        return expression

    def handle_if_statement(self, stmt, stmt_upper):
        """Handle IF...GOTO statements with comparison operators"""
        try:
            # Parse IF condition GOTO target
            # Examples: IF X = 5 GOTO 100, IF A < B GOTO 50
            if "GOTO" not in stmt_upper:
                print(f"Error on line {self.pc}: IF statement missing GOTO")
                sys.exit(1)
            
            # Split on GOTO
            if_part, goto_part = stmt_upper.split("GOTO", 1)
            target_line = int(goto_part.strip())
            
            # Extract condition from IF part
            condition = if_part[2:].strip()  # Remove "IF"
            
            # Parse comparison operators
            operators = ["<=", ">=", "<>", "=", "<", ">"]
            condition_result = False
            
            for op in operators:
                if op in condition:
                    left, right = condition.split(op, 1)
                    left_val = self.safe_eval(left.strip(), self.pc)
                    right_val = self.safe_eval(right.strip(), self.pc)
                    
                    if op == "=":
                        condition_result = left_val == right_val
                    elif op == "<>":
                        condition_result = left_val != right_val
                    elif op == "<":
                        condition_result = left_val < right_val
                    elif op == ">":
                        condition_result = left_val > right_val
                    elif op == "<=":
                        condition_result = left_val <= right_val
                    elif op == ">=":
                        condition_result = left_val >= right_val
                    break
            else:
                print(f"Error on line {self.pc}: Invalid IF condition syntax")
                sys.exit(1)
            
            # If condition is true, GOTO target line
            if condition_result:
                if target_line in self.program:
                    return target_line
                else:
                    print(f"Error on line {self.pc}: GOTO target line {target_line} does not exist")
                    sys.exit(1)
            
            # If condition is false, continue to next line
            return None
            
        except (ValueError, IndexError) as e:
            print(f"Error on line {self.pc}: Invalid IF...GOTO syntax")
            sys.exit(1)

    def run(self):
        while self.pc in self.program:
            stmt = self.program[self.pc]
            next_pc = self.execute(stmt)
            if stmt.upper().startswith("END"):
                break

            # Use the returned PC or move to next line
            if next_pc is not None:
                self.pc = next_pc
            else:
                # Move to next line if not changed by GOTO/GOSUB/RETURN
                next_lines = sorted([n for n in self.program if n > self.pc])
                self.pc = next_lines[0] if next_lines else None

    def execute(self, stmt):
        # Convert statement to uppercase for case-insensitive keyword matching
        stmt_upper = stmt.upper()
        
        # Check if this might be a function call (contains parentheses but not IF/FOR/INPUT)
        if ('(' in stmt and ')' in stmt and 
            not stmt_upper.startswith(('IF ', 'FOR ', 'INPUT ', 'PRINT '))):
            
            # Try to parse as function call
            if self.try_execute_function_call(stmt):
                return None
        
        if stmt_upper.startswith("GOTO"):
            # Example: GOTO 100
            try:
                target_line = int(stmt_upper.split()[1])
                if target_line in self.program:
                    return target_line
                else:
                    print(f"Error on line {self.pc}: GOTO target line {target_line} does not exist")
                    sys.exit(1)
            except (IndexError, ValueError):
                print(f"Error on line {self.pc}: Invalid GOTO syntax")
                sys.exit(1)
        
        elif stmt_upper.startswith("GOSUB"):
            # Example: GOSUB 1000
            try:
                target_line = int(stmt_upper.split()[1])
                if target_line in self.program:
                    # Find the next line after current line for return address
                    next_lines = sorted([n for n in self.program if n > self.pc])
                    return_address = next_lines[0] if next_lines else None
                    
                    # Push return address onto gosub stack
                    self.gosub_stack.append(return_address)
                    
                    # Jump to subroutine
                    return target_line
                else:
                    print(f"Error on line {self.pc}: GOSUB target line {target_line} does not exist")
                    sys.exit(1)
            except (IndexError, ValueError):
                print(f"Error on line {self.pc}: Invalid GOSUB syntax")
                sys.exit(1)
        
        elif stmt_upper.startswith("RETURN"):
            # Return from subroutine
            if not self.gosub_stack:
                print(f"Error on line {self.pc}: RETURN without GOSUB")
                sys.exit(1)
            
            return_address = self.gosub_stack.pop()
            if return_address is not None:
                return return_address
            else:
                # End of program
                return None
        
        elif stmt_upper.startswith("IF"):
            # Example: IF X = 5 GOTO 100
            # Example: IF X < 10 GOTO 200
            return self.handle_if_statement(stmt, stmt_upper)
        
        elif stmt_upper.startswith("LET"):
            # Example: LET A = 5
            _, expr = stmt.split(" ", 1)
            var, val = expr.split("=")
            self.vars[var.strip()] = self.safe_eval(val.strip(), self.pc)

        elif stmt_upper.startswith("PRINT"):
            _, expr = stmt.split(" ", 1)
            print(self.safe_eval(expr.strip(), self.pc))

        elif stmt_upper.startswith("INPUT"):
            # Example: INPUT "Enter your name: ", NAME
            _, expr = stmt.split(" ", 1)
            if "," in expr:
                prompt, var = expr.split(",", 1)
                prompt = prompt.strip().strip('"')
                var = var.strip()
                user_input = input(prompt)
                # Try to convert to number if possible, otherwise keep as string
                try:
                    self.vars[var] = float(user_input) if '.' in user_input else int(user_input)
                except ValueError:
                    self.vars[var] = user_input
            else:
                # Simple INPUT without prompt
                var = expr.strip()
                user_input = input()
                try:
                    self.vars[var] = float(user_input) if '.' in user_input else int(user_input)
                except ValueError:
                    self.vars[var] = user_input

        elif stmt_upper.startswith("FOR"):
            # Example: FOR I = 1 TO 10
            # Example: FOR I = 1 TO 10 STEP 2
            _, expr = stmt.split(" ", 1)
            parts = expr.split()
            var = parts[0]
            start_val = self.safe_eval(parts[2], self.pc)
            to_idx = next(i for i, part in enumerate(parts) if part.upper() == "TO")
            end_val = self.safe_eval(parts[to_idx + 1], self.pc)
            
            # Check for STEP
            step_val = 1
            step_indices = [i for i, part in enumerate(parts) if part.upper() == "STEP"]
            if step_indices:
                step_idx = step_indices[0]
                step_val = self.safe_eval(parts[step_idx + 1], self.pc)
            
            # Initialize loop variable
            self.vars[var] = start_val
            
            # Push loop info onto stack
            self.for_stack.append({
                'var': var,
                'end': end_val,
                'step': step_val,
                'line': self.pc
            })

        elif stmt_upper.startswith("NEXT"):
            # Example: NEXT I or just NEXT
            # Example: NEXT I or just NEXT
            if not self.for_stack:
                print("NEXT without FOR")
                return None
                
            loop_info = self.for_stack[-1]
            var = loop_info['var']
            
            # Check if variable specified and matches
            if len(stmt.split()) > 1:
                specified_var = stmt.split()[1]
                if specified_var != var:
                    print(f"NEXT {specified_var} doesn't match FOR {var}")
                    return None
            
            # Increment loop variable
            self.vars[var] += loop_info['step']
            
            # Check if loop should continue
            if ((loop_info['step'] > 0 and self.vars[var] <= loop_info['end']) or
                (loop_info['step'] < 0 and self.vars[var] >= loop_info['end'])):
                # Continue loop - jump back to line after FOR
                for_line = loop_info['line']
                next_lines = sorted([n for n in self.program if n > for_line])
                if next_lines:
                    return next_lines[0]
            else:
                # Exit loop
                self.for_stack.pop()

        elif stmt_upper.startswith("END"):
            print("Program finished.")

        elif stmt_upper.startswith("REM"):
            # Comment - do nothing
            pass

        elif stmt_upper.startswith("DEF "):
            # Function definition - should have been removed during parsing, skip
            print(f"Warning: DEF statement found during execution on line {self.pc}")
            pass

        elif stmt_upper.startswith("ENDDEF"):
            # End of function definition - should have been removed during parsing, skip
            print(f"Warning: ENDDEF statement found during execution on line {self.pc}")
            pass

        else:
            print(f"Unknown statement: {stmt}")
            
        return None

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("Usage: pybas program.pybas")
        sys.exit(1)

    filename = sys.argv[1]
    with open(filename) as f:
        lines = f.readlines()

    interpreter = BasicInterpreter(lines)
    interpreter.run()
